<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (INFOPLIST_KEY_* build settings). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<!-- Freizeitkarte map catalog: HTTP only, the HTTPS certificate does not cover this host.
			     The map files themselves are loaded over HTTPS from download.freizeitkarte-osm.de. -->
			<key>repository.freizeitkarte-osm.de</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
