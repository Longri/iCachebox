# Auf dem Server als .env speichern; keine Anführungszeichen und kein export.
# Die Datei wird als UTF-8 Java Properties gelesen, NICHT von einer Shell ausgeführt.
ADMIN_USER=
# Mindestens 10 Zeichen, maximal 72 UTF-8-Bytes. Kein Vorgabepasswort.
# Rückstriche müssen als \\ geschrieben werden; am besten ein langes zufälliges Passwort verwenden.
ADMIN_PASSWORD=
# Gültigkeit der optionalen Anmeldung per Remember-Me-Cookie in Tagen (Standard: 14).
ADMIN_REMEMBER_ME_DAYS=14
# Verzeichnis außerhalb der Jar; für den Dienstbenutzer schreibbar, nicht öffentlich ausliefern.
ANALYTICS_DIRECTORY=./data
# Optional: lokale MaxMind GeoLite2-Country-Datenbank (nicht im Git).
GEOIP_DATABASE=
# Optional: exakte IPs der eigenen vorgeschalteten Proxies, durch Komma getrennt.
# Nur setzen, wenn der Proxy X-Forwarded-For überschreibt oder die echte Client-IP anhängt.
ANALYTICS_TRUSTED_PROXIES=

# Von Groundspeak freigeschaltete Partner-Zugangsdaten für iCachebox (nicht der persönliche Token).
GROUNDSPEAK_CLIENT_ID=
GROUNDSPEAK_CLIENT_SECRET=
# Exakt diese URL bei Groundspeak registrieren, z. B. https://deine-domain.de/oauth/groundspeak/callback
# Lokal: http://localhost:8082/oauth/groundspeak/callback (benötigt ebenfalls eine passende Freischaltung).
GROUNDSPEAK_REDIRECT_URI=
# true nur zusammen mit Groundspeak-Staging-Zugangsdaten und registrierter Staging-Callback-URL.
GROUNDSPEAK_STAGING=false
